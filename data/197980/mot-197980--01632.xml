      <pb facs="riksdagen-motions-pdf/data/197980/mot_197980__1632/mot_197980__1632-001.pdf"/>
      <fw xml:id="i-LMD9cko2paD2TWpmormEHX">
        Motion 1979/80: 1632
      </fw>
      <div xml:id="i-5wANGAvahrRYHa4XZyUMDL" type="motHeader">
        <div xml:id="i-BRRPEzACLoBbAnjrcJogMQ" type="motTitle"/>
        <div xml:id="i-FwNoMmLWDymHxr4mT1Ettr" type="motSubmissionInfo"/>
