          <p xml:id="i-MLGWH3JsPU6nRfBMCgK9Ew">
            Nr B 77
          </p>
          <p xml:id="i-6W3n3XBanjvaeC23zrrSfs" type="titleString">
            Av herrar Söderquist och Ollén, angående viss tjänstårsberäk-
            ning för lärare i de svenska missionssällskapens tjänst.
          </p>
          <p xml:id="i-PPwSxoC7HGDFyKM7QvvHdZ">
            (Lika lydande med motion nr B 51 i Andra kammaren)
          </p>
          <p xml:id="i-Wga7MYnXHwvSzwXqpwEYnp" type="date">
            Stockholm den 26 juni 1958
          </p>
          <signatureBlock xml:id="i-5s2UrP2Ex67ffyCJn2HJav">
