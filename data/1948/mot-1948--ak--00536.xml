          <p xml:id="i-Ma8gqGnKPBYsfZq9pPuYGn" type="titleString">
            Av herr Lindahl m. fl., i anledning av Kungl. Maj:ts proposition,
            nr 215, med förslag till förordning om pappersskatt.
          </p>
          <p xml:id="i-DXiz4hVyxFsMfuQKpXri3x">
            (Lika lydande med motion i Första kammaren nr 380.)
          </p>
          <p xml:id="i-833o4KEcXFQQj2ijjUo7Jr" type="date">
            Stockholm den 7 maj 1948.
          </p>
          <signatureBlock xml:id="i-6Hi8sfwhWoyDSm6ErX5kD6">
