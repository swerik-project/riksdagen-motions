    <body>
      <pb facs="riksdagen-motions-pdf/data/1958/mot_1958_a_ak__64/mot_1958_a_ak__64-001.pdf"/>
      <fw xml:id="i-Jzg3wf8u83XW5MoerWqdTy">
        Motioner i Andra kammaren, nr 63—64 år 1958 3 Det synes oss därför
        väl motiverat att inspektor Hellner hålles skadeslös av statsverket,
        och vi får hemställa,
      </fw>
      <div xml:id="i-MmCjLGDP2XEJyno4KX6oZQ" type="motHeader">
        <div xml:id="i-LLeyRtsPikSH1DMnU4DD9f" type="motTitle"/>
